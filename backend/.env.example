# PostgreSQL connection — set automatically by docker-compose
DATABASE_URL=postgresql+asyncpg://publicai:publicai_dev@postgres:5432/publicai_foundry

# LLM provider — required for orchestrator and agent chat
MISTRAL_API_KEY=your-mistral-api-key-here

# Web search — powers web_search, eligibility_checker, service_locator, rights_lookup tools
TAVILY_API_KEY=your-tavily-api-key-here

# Voice (optional — voice endpoints will be disabled if not set)
ELEVENLABS_API_KEY=
